# Stripe API keys (get these from https://dashboard.stripe.com/apikeys)
# Use restricted keys in production when possible
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Connected account ID (starts with acct_)
# Create connected accounts in Stripe Dashboard > Connect
STRIPE_CONNECTED_ACCOUNT_ID=acct_your_connected_account_id

# Optional: amount in cents (default: 1000 = $10.00)
PAYOUT_AMOUNT_CENTS=1000

# Optional: currency (default: usd)
PAYOUT_CURRENCY=usd
